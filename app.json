{
  "expo": {
    "name": "Carnet Auto DZ",
    "slug": "carnet-auto-dz",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "dz.carnetauto.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#101D35"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3478F6",
          "defaultChannel": "maintenance-reminders"
        }
      ],
      "expo-navigation-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content",
      "borderColor": "#E5EAF2",
      "enforceContrast": false
    }
  }
}
